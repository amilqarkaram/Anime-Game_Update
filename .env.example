# Copy this file to .env and fill in your own values. Never commit .env.

# Local MongoDB (the default if MONGODB_URI is not set):
MONGODB_URI=mongodb://127.0.0.1:27017/animeDB
# Or a MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/animeDB

PORT=3000

# Any long random string; it signs the session cookie that keeps each
# player's game separate. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
