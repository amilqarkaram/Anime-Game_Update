<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>Anime Game</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" href="styles-game.css">
  </head>
  <body>
  <h1>How well do you know your anime?</h1>
  <div class="game">
  <div class="image">
    <% if (imageSrc) { %>
    <img style="width: 20%; height: 20%" src="<%= imageSrc %>" alt="Which title is this?">
  <% } else { %>
    <p><%= src %></p>
  <% } %>
  </div>
  <!-- the buttons only carry their position; the server knows the answer -->
  <form class="answerChoices" action="/game" method="post">
    <input type="hidden" name="question" value="<%= questionIndex %>">
    <% for (let row = 0; row < 2; row++) { %>
    <div class="row">
      <% for (let i = row * 2; i < row * 2 + 2; i++) { %>
      <div class="col-12 col-lg-6 button">
        <button class="btn btn-light btn-lg" type="submit" name="choice" value="<%= i %>"><%= choices[i] %></button>
      </div>
      <% } %>
    </div>
    <% } %>
  </form>
</div>
  <script src="extra-game.js" charset="utf-8"></script>
  </body>

</html>
