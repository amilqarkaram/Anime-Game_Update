<%
  // the choices on this page come from lib/settings.js, and `form` holds what
  // the player picked last time so a page shown with an error keeps them
  const has = (field, value) => (form[field] || []).includes(value);
%>
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>Anime Game</title>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles-index.css">
  </head>
  <body>
    <header>
      <h1>AnimeSannin</h1>
    </header>
  <div class="center spaced">
    <h1>How well do you know your anime?</h1>
    <div class="spaced">
      <p>Hello fellow anime enthusiasts! I created this game as a fun way to test the breadth of your knowledge! <br></p>
      <p>First, pick a few genres that you want to test your expertise in!</p>
    </div>
    <% if (error) { %>
      <div class="alert alert-warning error-message" role="alert"><%= error %></div>
    <% } %>
    <!-- every choice is a real form field, so pressing Play sends them all in one request -->
    <form action="/start" method="post">
      <div class="genresTable">
        <% for (let i = 0; i < genres.length; i += 4) { %>
        <div class="row no-gutters">
          <% for (const g of genres.slice(i, i + 4)) { %>
          <div class="col-12 col-md-3"><label class="toggle"><input type="checkbox" name="genres" value="<%= g %>" <%= has("genres", g) ? "checked" : "" %>><span class="genres btn btn-success shadow-none"><%= g %></span></label></div>
          <% } %>
        </div>
        <% } %>
      </div>
      <p>Which do you know better?</p>
      <div class="mOrA">
        <div class="row no-gutters">
          <% for (const [value, text] of [["anime", "Anime"], ["manga", "Manga"]]) { %>
          <div class="col-12 col-md-6"><label class="toggle"><input type="checkbox" name="types" value="<%= value %>" <%= has("types", value) ? "checked" : "" %>><span class="genres btn btn-success shadow-none"><%= text %></span></label></div>
          <% } %>
        </div>
      </div>
      <p>What level are you at?</p>
      <div class="mOrA">
        <div class="row no-gutters">
          <% for (const d of difficulties) { %>
          <div class="col-12 col-md-4"><label class="toggle"><input type="radio" name="difficulty" value="<%= d %>" <%= (form.difficulty || difficulties[0]) === d ? "checked" : "" %>><span class="difficulty btn btn-success shadow-none"><%= d[0].toUpperCase() + d.slice(1) %></span></label></div>
          <% } %>
        </div>
      </div>
      <p>When were your weeb years?</p>
      <div class="genresTable">
        <div class="row no-gutters">
          <% for (const d of decades) { %>
          <div class="col-12 col-md-4"><label class="toggle"><input type="checkbox" name="decades" value="<%= d %>" <%= has("decades", d) ? "checked" : "" %>><span class="genres btn btn-success shadow-none"><%= d %>s</span></label></div>
          <% } %>
        </div>
      </div>
      <p>Finally, put in your username so you can showoff your score!</p>
      <div class="inputField">
        <input type="text" name="username" placeholder="Player Name" autocomplete="off" maxlength="<%= maxUsername %>" value="<%= form.username === "Anonymous" ? "" : (form.username || "") %>">
      </div>
      <div class="play">
        <h6>Whenever you're ready, click play below!</h6>
        <button class="btn btn-success btn-lg" type="submit">Play!</button>
      </div>
    </form>
  </div>
  </body>
</html>
